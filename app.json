{
  "expo": {
    "name": "Scenely",
    "slug": "scenely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scenely",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Scenely uses speech recognition to check which words of the sentence it heard.",
        "NSMicrophoneUsageDescription": "Scenely uses the microphone so you can say sentences out loud and hear how you did."
      },
      "bundleIdentifier": "com.nivedhithap.scenelyapp",
      "googleServicesFile": "./firebase/GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F29B62",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.nivedhithap.scenelyapp",
      "googleServicesFile": "./firebase/google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#172120",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Scenely uses the microphone so you can say sentences out loud and hear how you did.",
          "speechRecognitionPermission": "Scenely uses speech recognition to check which words of the sentence it heard."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#F29B62"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
